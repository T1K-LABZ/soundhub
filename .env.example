VITE_API_BASE_URL=http://localhost:3000/api
# Public store ID used when requesting the existing inventory endpoint.
VITE_STOREFRONT_STORE_ID=
# Server-side endpoint that creates the order and triggers Daraja STK Push.
VITE_STOREFRONT_CHECKOUT_ENDPOINT=/orders/checkout
# WhatsApp number in international format, e.g. 2547XXXXXXXX.
VITE_STOREFRONT_WHATSAPP_NUMBER=
# Set to admin for the admin.recoil.ke deployment and storefront for recoil.ke.
VITE_APP_SURFACE=storefront
